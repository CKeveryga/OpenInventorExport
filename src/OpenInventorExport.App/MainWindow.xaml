<Window x:Class="OpenInventorExport.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Inventor Export" Width="1000" Height="720" MinWidth="700" MinHeight="500"
        Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="60" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Status line at the bottom: what the window is doing now -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="Gray" Text="Ready." />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Config file -->
            <DockPanel Grid.Row="0">
                <TextBlock Text="Config" Style="{StaticResource Label}" />
                <Button DockPanel.Dock="Right" Content="Reload" Click="OnReloadConfig" ToolTip="Read the config file again (after editing it)" />
                <Button DockPanel.Dock="Right" Content="Browse..." Click="OnBrowseConfig" />
                <TextBox x:Name="ConfigBox" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Row="1" x:Name="ConfigStatus" Margin="60,4,0,8" TextWrapping="Wrap" />

            <!-- Output folder and task -->
            <DockPanel Grid.Row="2" Margin="0,0,0,6">
                <TextBlock Text="Output" Style="{StaticResource Label}" />
                <Button DockPanel.Dock="Right" Content="Open folder" Click="OnOpenOutput" />
                <Button DockPanel.Dock="Right" Content="Browse..." Click="OnBrowseOutput" />
                <TextBox x:Name="OutputBox" VerticalContentAlignment="Center" LostFocus="OnOutputEdited"
                         ToolTip="Exports, tables, logs and snapshot.json are written here" />
            </DockPanel>
            <DockPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Task" Style="{StaticResource Label}" />
                <ComboBox x:Name="TaskBox" Width="300" HorizontalAlignment="Left"
                          ToolTip="Plan and run every task, or just one" />
            </DockPanel>

            <!-- Snapshot: collect from Inventor or load a saved one -->
            <DockPanel Grid.Row="4" Margin="0,4,0,8">
                <Button x:Name="CollectButton" Content="1  Collect from Inventor" Margin="0" Click="OnCollect"
                        ToolTip="Reads the active assembly in the running Inventor (read-only) and saves snapshot.json in the output folder" />
                <Button x:Name="LoadButton" Content="Load snapshot..." Click="OnLoadSnapshot"
                        ToolTip="Use a snapshot.json saved earlier instead of collecting" />
                <Button x:Name="PlanButton" Content="2  Plan" Margin="16,0,0,0" Click="OnPlan" IsEnabled="False"
                        ToolTip="Works out what would be exported and where, and what the rules leave out. Exports nothing." />
                <TextBlock x:Name="SnapshotStatus" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="No snapshot yet. Collect from Inventor, or load a saved snapshot." Foreground="Gray" />
            </DockPanel>

            <TabControl Grid.Row="5" x:Name="Tabs">
            <TabItem Header="Summary">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <!-- Warnings first, where they cannot be missed -->
                        <TextBlock x:Name="WarningText" Foreground="DarkRed" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,0,0,8" Visibility="Collapsed" />
                        <Grid x:Name="SummaryGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Expander Header="All details" Margin="0,10,0,0">
                            <TextBox x:Name="DetailsBox" IsReadOnly="True" FontFamily="Consolas" BorderThickness="0"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- The plan: one row per file to export and per table. Step 5 adds the results of a run. -->
            <TabItem x:Name="PlanTab" Header="Plan">
                <DockPanel Margin="6">
                    <TextBlock x:Name="PlanInfo" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Collect or load a snapshot, then press Plan." Foreground="Gray" />
                    <TextBlock x:Name="PlanWarnings" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4"
                               Foreground="DarkRed" FontWeight="SemiBold" Visibility="Collapsed" />
                    <DockPanel DockPanel.Dock="Top" Margin="0,2,0,6">
                        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="PlanFilter" Width="300" HorizontalAlignment="Left" TextChanged="OnPlanFilterChanged"
                                 ToolTip="Shows only rows containing this text (file, description, task, format, state, folder...)" />
                    </DockPanel>
                    <DataGrid x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" />
                            <DataGridTextColumn Header="Task" Binding="{Binding Task}" />
                            <DataGridTextColumn Header="Format" Binding="{Binding Format}" />
                            <DataGridTextColumn Header="From" Binding="{Binding Source}" />
                            <DataGridTextColumn Header="File" Binding="{Binding File}" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" MaxWidth="300" />
                            <DataGridTextColumn Header="Written to" Binding="{Binding Output}" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="LeftOutTab" Header="Left out by rules">
                <DockPanel Margin="6">
                    <TextBlock x:Name="LeftOutInfo" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="Gray"
                               Text="What each task's rules leave out, and why. Shown after Plan." />
                    <DataGrid x:Name="LeftOutGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Task" Binding="{Binding Context}" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" />
                            <DataGridTextColumn Header="Occurrence" Binding="{Binding OccurrencePath}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="UnreadableTab" Header="Unreadable">
                <DockPanel Margin="6">
                    <TextBlock x:Name="UnreadableInfo" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="Gray"
                               Text="Components Inventor could not read. Shown after Plan." />
                    <DataGrid x:Name="UnreadableGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" />
                            <DataGridTextColumn Header="Occurrence" Binding="{Binding OccurrencePath}" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
