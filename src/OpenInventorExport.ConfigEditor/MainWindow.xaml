<Window x:Class="OpenInventorExport.ConfigEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenInventorExport.ConfigEditor"
        Title="Config Editor" Width="1000" Height="720"
        Closing="OnClosing">
    <Window.Resources>
        <local:NullableChoiceConverter x:Key="NullableChoice" />
        <local:CommaListConverter x:Key="CommaList" />
        <local:PropertyNamesConverter x:Key="PropertyNames" />

        <!-- Property name cell: shows the name; while editing, a drop-down of known names that also accepts typing
             (it fills in as you type). Suggestions follow the row's Set. -->
        <DataTemplate x:Key="PropertyNameCell">
            <TextBlock Text="{Binding Name}" Margin="2,0" />
        </DataTemplate>
        <DataTemplate x:Key="PropertyNameEditor">
            <ComboBox IsEditable="True"
                      ItemsSource="{Binding Set, Converter={StaticResource PropertyNames}}"
                      Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Heading">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button Content="New" Width="80" Margin="0,0,4,0" Click="OnNew" />
            <Button Content="Open..." Width="80" Margin="0,0,4,0" Click="OnOpen" />
            <Button Content="Save" Width="80" Margin="0,0,4,0" Click="OnSave" />
            <Button Content="Save as..." Width="80" Click="OnSaveAs" />
        </StackPanel>

        <!-- Problems panel -->
        <DockPanel DockPanel.Dock="Bottom" Margin="8" Height="140">
            <TextBlock DockPanel.Dock="Top" x:Name="ProblemsHeading" FontWeight="Bold" Margin="0,0,0,4" />
            <ListBox x:Name="ProblemsList" />
        </DockPanel>

        <Grid Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: General + tasks -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Add task" Width="80" Margin="0,0,4,0" Click="OnAddTask" />
                    <Button Content="Remove task" Width="90" Click="OnRemoveTask" />
                </StackPanel>
                <ListBox x:Name="PageList" SelectionChanged="OnPageSelected" />
            </DockPanel>

            <!-- Right: General page -->
            <ScrollViewer Grid.Column="1" x:Name="GeneralPage" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Unreadable components" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Label}" Text="Unresolved" />
                        <ComboBox Width="120" ItemsSource="{x:Static local:Choices.UnresolvedPolicies}"
                                  SelectedItem="{Binding Unresolved}" />
                        <TextBlock Style="{StaticResource Label}" Margin="8,0,0,0" Foreground="Gray"
                                   Text="Block: exports refuse to run. Warn: export what can be read." />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Heading}" Text="Rollup (the bom command; fallback Mode and Key for tables)" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Mode" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" ItemsSource="{x:Static local:Choices.RollupModes}"
                                  SelectedItem="{Binding Rollup.Mode}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Label}" Text="Key" />
                        <ComboBox Grid.Row="0" Grid.Column="4" Margin="0,2" ItemsSource="{x:Static local:Choices.RollupKeys}"
                                  SelectedItem="{Binding Rollup.Key}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Content Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" ItemsSource="{x:Static local:Choices.ContentCenterModes}"
                                  SelectedItem="{Binding Rollup.ContentCenter}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Label}" Text="Inseparable" />
                        <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,2" ItemsSource="{x:Static local:Choices.InseparableChoices}"
                                  SelectedItem="{Binding Rollup.Inseparable, Converter={StaticResource NullableChoice}}" />
                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4" Content="Include assemblies"
                                  IsChecked="{Binding Rollup.IncludeAssemblies}" />
                        <CheckBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,4" Content="Include root"
                                  IsChecked="{Binding Rollup.IncludeRoot}" />
                        <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4" Content="Exclude suppressed"
                                  IsChecked="{Binding Rollup.ExcludeSuppressed}" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Foreground="Gray" VerticalAlignment="Center"
                                   Text="BOM structure rules: in a later step" />
                    </Grid>

                    <TextBlock Style="{StaticResource Heading}" Text="BOM columns (default columns for bom and for tables)" />
                    <DataGrid ItemsSource="{Binding BomColumns}" AutoGenerateColumns="False" MinHeight="80" MaxHeight="200"
                              CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Set" Width="240" ItemsSource="{x:Static local:Choices.PropertySets}"
                                                    SelectedItemBinding="{Binding Set}" />
                            <DataGridTemplateColumn Header="Name" Width="*"
                                                    CellTemplate="{StaticResource PropertyNameCell}"
                                                    CellEditingTemplate="{StaticResource PropertyNameEditor}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource Heading}" Text="Property check (the props command; selects nothing)" />
                    <DataGrid ItemsSource="{Binding Properties}" AutoGenerateColumns="False" MinHeight="80" MaxHeight="200"
                              CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Set" Width="240" ItemsSource="{x:Static local:Choices.PropertySets}"
                                                    SelectedItemBinding="{Binding Set}" />
                            <DataGridTemplateColumn Header="Name" Width="*"
                                                    CellTemplate="{StaticResource PropertyNameCell}"
                                                    CellEditingTemplate="{StaticResource PropertyNameEditor}" />
                            <DataGridComboBoxColumn Header="Type" Width="90" ItemsSource="{x:Static local:Choices.DataTypes}"
                                                    SelectedItemBinding="{Binding DataType}" />
                            <DataGridCheckBoxColumn Header="Required" Width="70" Binding="{Binding Required}" />
                            <DataGridTemplateColumn Header="Applies to (none ticked = all)" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="2,0"
                                                   Text="{Binding AppliesTo, Converter={StaticResource CommaList}, ConverterParameter=(all)}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <local:DocumentTypePicker Types="{Binding AppliesTo}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Foreground="Gray" Margin="0,4,0,0"
                               Text="Rows: click the empty last row to add one; select a row and press Delete to remove it." />
                </StackPanel>
            </ScrollViewer>

            <!-- Right: Task page (only name and root folder in this step) -->
            <ScrollViewer Grid.Column="1" x:Name="TaskPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Name" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Root folder" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                             Text="{Binding FolderTemplate, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBlock Foreground="Gray" Margin="0,4,0,0"
                           Text="Root folder tokens: {task}, {format}, {type}. Default {task}." />

                <TextBlock Style="{StaticResource Heading}" Text="Selection (which files this task exports and lists in its tables)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Scope" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" ItemsSource="{x:Static local:Choices.Scopes}"
                              SelectedItem="{Binding Selection.Scope}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Foreground="Gray" VerticalAlignment="Center"
                               Text="AllUniqueFiles: every file in the assembly. TopLevelOnly: the open assembly itself." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Content Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" ItemsSource="{x:Static local:Choices.ContentCenterModes}"
                              SelectedItem="{Binding Selection.ContentCenter}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Foreground="Gray" VerticalAlignment="Center"
                               Text="Include: all parts. Exclude: leave Content Center parts out. Only: just those." />
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Document types" />
                    <local:DocumentTypePicker Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                              Types="{Binding Selection.DocumentTypes}" />
                </Grid>
                <TextBlock Foreground="Gray" Text="Document types: none ticked = all types." />

                <TextBlock Style="{StaticResource Heading}" Text="Filters and BOM structure rules (read only for now; editing comes in the next step)" />
                <TextBlock x:Name="TaskSummary" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource Heading}" Text="Outputs (what this task produces, each in an optional subfolder of the root folder)" />
                <DataGrid x:Name="OutputsGrid" ItemsSource="{Binding Outputs}" AutoGenerateColumns="False"
                          MinHeight="80" MaxHeight="220" CanUserAddRows="True" CanUserDeleteRows="True"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="Format" Width="70" ItemsSource="{x:Static local:Choices.Formats}"
                                                SelectedItemBinding="{Binding Format}" />
                        <DataGridTextColumn Header="Folder" Width="90" Binding="{Binding Folder}" />
                        <DataGridComboBoxColumn Header="Source (files)" Width="90" ItemsSource="{x:Static local:Choices.Sources}"
                                                SelectedItemBinding="{Binding Source}" />
                        <DataGridComboBoxColumn Header="Sheets (PDF)" Width="85" ItemsSource="{x:Static local:Choices.PdfSheetModes}"
                                                SelectedItemBinding="{Binding PdfSheets}" />
                        <DataGridTextColumn Header="Ini file (DWG/DXF)" Width="*" Binding="{Binding IniFile, TargetNullValue=''}" />
                        <DataGridTextColumn Header="Name (tables)" Width="100" Binding="{Binding Name, TargetNullValue=''}" />
                        <DataGridComboBoxColumn Header="Mode (tables)" Width="110" ItemsSource="{x:Static local:Choices.OutputModeChoices}"
                                                SelectedItemBinding="{Binding Mode, Converter={StaticResource NullableChoice}, ConverterParameter={x:Static local:Choices.FromGeneral}}" />
                        <DataGridComboBoxColumn Header="Key (tables)" Width="110" ItemsSource="{x:Static local:Choices.OutputKeyChoices}"
                                                SelectedItemBinding="{Binding Key, Converter={StaticResource NullableChoice}, ConverterParameter={x:Static local:Choices.FromGeneral}}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="STEP needs Source Model; PDF, DWG and DXF need Drawing; DWF either. Ini file: relative to the config file's folder, or a full path. Empty Name = the task name. Rows: click the empty last row to add; select a row and press Delete to remove." />

                <!-- Columns of the selected table output (shown only when a Csv or Xlsx row is selected) -->
                <StackPanel x:Name="TableColumnsPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Heading}" Text="Columns of the selected table (none = the BOM columns on the General page)" />
                    <DataGrid ItemsSource="{Binding Columns}" AutoGenerateColumns="False" MinHeight="80" MaxHeight="200"
                              CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Set" Width="240" ItemsSource="{x:Static local:Choices.PropertySets}"
                                                    SelectedItemBinding="{Binding Set}" />
                            <DataGridTemplateColumn Header="Name" Width="*"
                                                    CellTemplate="{StaticResource PropertyNameCell}"
                                                    CellEditingTemplate="{StaticResource PropertyNameEditor}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Foreground="Gray" Margin="0,4,0,0"
                               Text="Every table starts with File Name and Qty and ends with Status; these are the columns in between." />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
