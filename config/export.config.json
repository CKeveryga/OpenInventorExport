{
	"SchemaVersion": 1,

	"Unresolved": "Block", 

	"Tasks": [
		{
			"Name": "Drawings",
			"FolderTemplate": "{task}/{format}",
			"Selection": {
				"Scope": "AllUniqueFiles",
				"DocumentTypes": [ "Part", "SheetMetal" ]
			},
			"Outputs": [
				{ "Format": "Pdf", "Source": "Drawing", "PdfSheets": "AllInOne" },
				{ "Format": "Dwg", "Source": "Drawing", "IniFile": "dwg-one-sheet.ini" },
				{ "Format": "Dxf", "Source": "Drawing", "IniFile": "dxf-one-sheet.ini" },
				{ "Format": "Xlsx", "Folder": "Tables", "Columns": [ { "Name": "Part Number" }, { "Name": "Material" } ] },
				{ "Format": "Csv", "Folder": "Tables", "Name": "ERP_Import", "Mode": "Occurrence", "Key": "FilePath" }
			]
		}
	],

	"Properties": [
		{
			"Set": "Inventor User Defined Properties",
			"Name": "Finish",
			"DataType": "Text",
			"Required": true
		}
	],

	"Rollup": {
		"Mode": "Structured",
		"IncludeAssemblies": true,
		"Key": "FilePath"
	},

	"BomColumns": [
		{ "Name": "Part Number" },
		{ "Name": "Description" },
		{ "Name": "Material" }
	]
}