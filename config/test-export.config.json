{
	"SchemaVersion": 1,

	"Unresolved": "Warn",

	"Tasks": [
		{
			"Name": "SheetMetalDrawings",
			"FolderTemplate": "{task}",
			"Selection": {
				"Scope": "AllUniqueFiles",
				"DocumentTypes": [ "SheetMetal" ],
				"BomStructures": [ { "Structure": "Purchased", "Children": "Include" }, { "Structure": "Reference", "Children": "Exclude" } ],
				"ContentCenter": "Exclude"
			},
			"Outputs": [
				{ "Format": "Pdf", "Source": "Drawing", "PdfSheets": "AllInOne", "Folder": "PDF" },
				{ "Format": "Dwg", "Source": "Drawing", "IniFile": "dwg-one-sheet.ini" },
				{ "Format": "Dxf", "Source": "Drawing", "IniFile": "dxf-one-sheet.ini" },
				{ "Format": "Xlsx", "Columns": [ { "Name": "Part Number" }, { "Name": "Material" } ] },
				{ "Format": "Csv" }
			]
		},
				{
			"Name": "PartDrawings",
			"FolderTemplate": "{task}",
			"Selection": {
				"Scope": "AllUniqueFiles",
				"DocumentTypes": [ "Part" ],
				"BomStructures": [ { "Structure": "Purchased", "Children": "Include" }, { "Structure": "Reference", "Children": "Exclude" } ],
				"ContentCenter": "Include"
			},
			"Outputs": [
				{ "Format": "Pdf", "Source": "Drawing", "PdfSheets": "AllInOne" },
				{ "Format": "Csv" }
			]
		},
		{
			"Name": "AssemblyDrawings",
			"FolderTemplate": "{task}",
			"Selection": {
				"Scope": "AllUniqueFiles",
				"DocumentTypes": [ "Assembly"],
				"ContentCenter": "Exclude"
			},
			"Outputs": [
				{ "Format": "Pdf", "Source": "Drawing", "PdfSheets": "AllInOne" }
			]
		},
		{
			"Name": "StepFiles",
			"FolderTemplate": "{task}",
			"Selection": {
				"Scope": "AllUniqueFiles",
				"DocumentTypes": [ "Part" ],
				"ContentCenter": "Exclude",
				"Filters": [
					{ "Property": "Designer", "Operator": "Contains", "Value": "yuany" },
					{ "Property": "Vendor", "Operator": "NotEquals", "Value": "ABC" },
					{ "Set": "Inventor User Defined Properties", "Property": "Length", "Operator": "LessThan", "Value": "200" },
					{ "Property": "Vendor", "Operator": "NotEquals", "Value": "DEF" }]
			},
			"Outputs": [
				{ "Format": "step", "Source": "Model" },
				{ "Format": "Csv", "Columns": [ { "Name": "Part Number" }, { "Name": "Designer" } ]}
			]
		}
	],

	"Properties": [
		{
			"Set": "Inventor User Defined Properties",
			"Name": "Finish",
			"DataType": "Text",
			"Required": true
		}
	],

	"Rollup": {
		"Mode": "Occurrence",
		"IncludeAssemblies": false
	},

	"BomColumns": [
		{ "Name": "Part Number" },
		{ "Name": "Description" },
		{ "Name": "Material" }
	]
}